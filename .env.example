# Scholens Environment Variables
# This is the single committed configuration catalog. Copy only the variables
# owned by each runtime into server/.env, jobs/.env, web/.env.local, or
# client/.env.local. Never copy server or jobs secrets into either frontend
# directory. Runtime files are git-ignored and must never contain committed
# credentials.

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL (shared SanchezCloud database)
# ═══════════════════════════════════════════════════════════════════
# Local example. To share local users with Scholight, point this at the same
# sanchezcloud database that contains auth.users.
DATABASE_URL=postgresql://scholens_app:replace-with-local-runtime-password@127.0.0.1:55432/sanchezcloud
# sanchezcloud-identity's independent migration CLI reads AUTH_DATABASE_URL explicitly.
AUTH_DATABASE_URL=postgresql://scholens_app:replace-with-local-runtime-password@127.0.0.1:55432/sanchezcloud
# Explicit migration/reset credentials used only by guarded CLI commands.
SCHOLENS_MIGRATION_DATABASE_URL=postgresql://scholens_migrator:replace-with-local-migration-password@127.0.0.1:55432/sanchezcloud
LOCAL_DATABASE_ADMIN_URL=postgresql://postgres:replace-with-local-admin-password@127.0.0.1:55432/sanchezcloud
AUTH_MIGRATION_ROLE=auth_migrator
SCHOLENS_MIGRATION_ROLE=scholens_migrator
SCHOLENS_APP_ROLE=scholens_app

# ECS injects these fields independently and composes a verify-full URL at startup.
# Local development continues to use DATABASE_URL above.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=55432
DATABASE_NAME=sanchezcloud
DATABASE_USERNAME=scholens_app
DATABASE_PASSWORD=replace-with-local-runtime-password

# Production uses separate least-privilege scholens_app/scholens_migrator
# roles and RDS TLS. See deploy/ecs/README.md.
AUTH_PG_SSL_ROOT_CERT=
AUTH_PG_POOL_MIN_SIZE=2
AUTH_PG_POOL_MAX_SIZE=10

# ═══════════════════════════════════════════════════════════════════
# JWT & sanchezcloud-identity
# ═══════════════════════════════════════════════════════════════════
# The client_id is fixed to "scholens" in code. Use a product-specific secret;
# do not reuse Scholight's JWT secret. Generate with: openssl rand -base64 32
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_JWT_REFRESH_TOKEN_TTL_DAYS=7
AUTH_ACCOUNT_LOCKOUT_THRESHOLD=5
AUTH_ACCOUNT_LOCKOUT_DURATION_MINUTES=15
AUTH_PUBLIC_WEB_URL=http://127.0.0.1:7300

# ═══════════════════════════════════════════════════════════════════
# Email (Aliyun DirectMail — password reset, email verification)
# ═══════════════════════════════════════════════════════════════════
# These may use the same Aliyun account as Scholight; sender alias and action
# URLs remain product-specific. Scholens local development sends real
# verification/reset mail through this provider; there is no Mailpit profile.
AUTH_ALIYUN_DM_ACCESS_KEY_ID=
AUTH_ALIYUN_DM_ACCESS_KEY_SECRET=
AUTH_ALIYUN_DM_ACCOUNT_NAME=
AUTH_ALIYUN_DM_FROM_ALIAS=Scholens
AUTH_ALIYUN_DM_REPLY_TO_ADDRESS=true

# ═══════════════════════════════════════════════════════════════════
# Public URLs / server
# ═══════════════════════════════════════════════════════════════════
CLIENT_DOMAIN=http://127.0.0.1:7300
# Comma-separated development browser origins. Production should contain only
# explicitly trusted deployed origins.
CLIENT_ALLOWED_ORIGINS=http://127.0.0.1:7300,http://127.0.0.1:7303
HOST=127.0.0.1
PORT=7301
RELOAD=false
ENVIRONMENT=development
RELEASE_SHA=development
PAPER_SEARCH_CURSOR_SECRET=development-only-search-cursor-secret
PAPER_SEARCH_BACKEND=postgres_fts

# Technical observability. Leave the OTLP endpoint and snapshot fields empty to
# disable exports locally. Production values come from the observability stack.
OTEL_EXPORTER_OTLP_ENDPOINT=
DIAGNOSTIC_SNAPSHOT_BUCKET=
DIAGNOSTIC_SNAPSHOT_KMS_KEY_ID=
DIAGNOSTIC_SUCCESS_SAMPLE_RATE=0.01

# ═══════════════════════════════════════════════════════════════════
# Object storage (isolated remote dev S3) [server + jobs]
# ═══════════════════════════════════════════════════════════════════
# Local Scholens uses a dedicated non-production bucket and least-privilege
# development keys. Production uses scoped ECS task roles instead of
# static AWS keys. Leave AWS_ENDPOINT_URL_S3 empty for AWS S3; Scholens does not
# use local MinIO by default.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL_S3=
AWS_S3_ADDRESSING_STYLE=virtual
# Example: scholens-dev-<aws-account-id>-<region>
S3_BUCKET_NAME=
# Canonical asset hostname without https://. For AWS use:
# <bucket>.s3.<region>.amazonaws.com. Presigned URLs retain the provider host.
CLOUDFLARE_BUCKET_NAME=
UPLOAD_DIR=uploads

# ═══════════════════════════════════════════════════════════════════
# AI workload profiles (internal only) [server + jobs]
# ═══════════════════════════════════════════════════════════════════
# Models use provider:model. The model prefix selects the provider adapter and
# endpoint; the current defaults do not make that provider part of the domain.
SCHOLENS_AI_DEEPSEEK_API_KEY=
SCHOLENS_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com
SCHOLENS_AI_OPENAI_API_KEY=
SCHOLENS_AI_STANDARD_MODEL=deepseek:deepseek-v4-flash
SCHOLENS_AI_STANDARD_THINKING=disabled
SCHOLENS_AI_STANDARD_THINKING_EFFORT=none
SCHOLENS_AI_DEEP_MODEL=deepseek:deepseek-v4-pro
SCHOLENS_AI_DEEP_THINKING=enabled
SCHOLENS_AI_DEEP_THINKING_EFFORT=max
SCHOLENS_AI_TRANSLATION_MODEL=deepseek:deepseek-v4-flash
SCHOLENS_AI_TRANSLATION_THINKING=disabled
SCHOLENS_AI_TRANSLATION_THINKING_EFFORT=none
SCHOLENS_AI_REQUEST_TIMEOUT_SECONDS=120
SCHOLENS_AI_MAX_OUTPUT_TOKENS=393216
SCHOLENS_AI_MAX_RETRIES=2
SCHOLENS_AI_STRUCTURED_RETRIES=2
SCHOLENS_AI_MAX_INPUT_CHARS=300000

# MinerU runtime policy. Each user connects their own token in Settings; the
# credential is encrypted by Server and delivered only to a claimed job.
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SECONDS=3
# Shared deadline for submit, upload, poll, and archive download before fallback.
MINERU_TASK_TIMEOUT_SECONDS=600
MINERU_REQUEST_TIMEOUT_SECONDS=60
MINERU_MAX_ARCHIVE_BYTES=268435456

# MOSS Voice runs in Jobs; the script itself is generated there by DeepSeek.
MOSS_API_KEY=
MOSS_API_BASE_URL=https://api.mosi.cn/v1
MOSS_TTS_MODEL=moss-tts
MOSS_VOICE_ID=
MOSS_POLL_INTERVAL_SECONDS=3
MOSS_TASK_TIMEOUT_SECONDS=600
MOSS_MAX_AUDIO_BYTES=104857600

# ═══════════════════════════════════════════════════════════════════
# Background jobs and shared cache
# ═══════════════════════════════════════════════════════════════════
# The optional local Jobs health API listens at http://127.0.0.1:7302.
CELERY_BROKER_URL=pyamqp://guest@127.0.0.1:55672//
# Production sets CELERY_BROKER_URL=sqs:// and injects these predefined URLs.
SQS_DOCUMENT_QUEUE_URL=
SQS_RESEARCH_QUEUE_URL=
SQS_MAINTENANCE_QUEUE_URL=
# Direct URL is convenient locally. ECS uses the split fields so the generated
# password remains a Secrets Manager value instead of a composed environment secret.
CACHE_URL=redis://127.0.0.1:56379/0
CACHE_HOST=
CACHE_PORT=6379
CACHE_USERNAME=
CACHE_PASSWORD=
CACHE_TLS=false
WEBHOOK_BASE_URL=http://127.0.0.1:7301
JOBS_WEBHOOK_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Server outbox polling interval; durable jobs remain in PostgreSQL until published.
JOB_DISPATCH_INTERVAL_SECONDS=1
# Time allowed to finalize one broker publish before another dispatcher may retry it.
JOB_DISPATCH_PUBLISH_LEASE_SECONDS=30
ZOTERO_SYNC_INTERVAL_SECONDS=60

# ═══════════════════════════════════════════════════════════════════
# Remote MCP search tools and integrations
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_MCP_URL=https://scholight.sanchezcloud.net/api/mcp
# Must match Scholight's SCHOLIGHT_MCP_DELEGATION_JWT_SECRET. Scholens creates a
# 60-second user delegation for each call; no platform access key is used.
SCHOLIGHT_MCP_DELEGATION_JWT_SECRET=replace-with-at-least-32-random-bytes
# URL-safe base64 encoding of exactly 32 random bytes.
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtaW50ZWdyYXRpb24ta2V5LTMyISE=
OPENALEX_API_KEY=
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=
ZOTERO_REDIRECT_URI=http://127.0.0.1:7301/api/v1/integrations/zotero/oauth/callback

# ═══════════════════════════════════════════════════════════════════
# Billing
# ═══════════════════════════════════════════════════════════════════
STRIPE_API_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ═══════════════════════════════════════════════════════════════════
# Product email, telemetry, and admin
# ═══════════════════════════════════════════════════════════════════
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_REPLY_TO_ADDRESS=
PROFILE_NOTIFICATION_EMAIL=
SOURCE_REPOSITORY_URL=https://github.com/EricSanchezok/scholens
POSTHOG_API_KEY=
DEBUG=false
ADMIN_SESSION_SECRET=replace-with-an-independent-32-byte-secret

# Cross-instance abuse controls use the shared CACHE configuration above.
AI_MAX_INTERACTIVE_PER_USER=8
AI_MAX_BACKGROUND_PER_USER=4
AI_MAX_AUDIO_PER_USER=2
AI_RATE_WINDOW_SECONDS=60
AI_RATE_PER_USER=60
AI_RATE_PER_IP=120
AI_CONCURRENCY_TTL_SECONDS=7200

# ═══════════════════════════════════════════════════════════════════
# Client (Next.js)
# ═══════════════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://127.0.0.1:7301
NEXT_PUBLIC_ACCOUNT_CENTER_URL=http://127.0.0.1:7100
# Canonical replacement Web value. The legacy client must override this with
# http://127.0.0.1:7303 in client/.env.local.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:7300
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_RELEASE_SHA=development
NEXT_PUBLIC_RUM_APPLICATION_ID=
NEXT_PUBLIC_RUM_GUEST_ROLE_ARN=
NEXT_PUBLIC_RUM_IDENTITY_POOL_ID=
NEXT_PUBLIC_RUM_REGION=
