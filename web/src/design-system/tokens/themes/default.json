{
  "primitive": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff" },
      "25": { "$type": "color", "$value": "#fafaf8" },
      "50": { "$type": "color", "$value": "#f5f5f3" },
      "100": { "$type": "color", "$value": "#ececea" },
      "150": { "$type": "color", "$value": "#e7e7e4" },
      "200": { "$type": "color", "$value": "#e4e4e1" },
      "300": { "$type": "color", "$value": "#d7d7d2" },
      "400": { "$type": "color", "$value": "#bbbbb5" },
      "500": { "$type": "color", "$value": "#a2a29c" },
      "550": { "$type": "color", "$value": "#94948e" },
      "600": { "$type": "color", "$value": "#73736e" },
      "700": { "$type": "color", "$value": "#5e5e59" },
      "800": { "$type": "color", "$value": "#4b4b47" },
      "900": { "$type": "color", "$value": "#323230" },
      "950": { "$type": "color", "$value": "#20201e" },
      "1000": { "$type": "color", "$value": "#141412" }
    },
    "status": {
      "info": {
        "subtle": { "$type": "color", "$value": "#eef3f6" },
        "strong": { "$type": "color", "$value": "#3b5665" }
      },
      "success": {
        "subtle": { "$type": "color", "$value": "#eff8f1" },
        "strong": { "$type": "color", "$value": "#2d6a45" }
      },
      "warning": {
        "subtle": { "$type": "color", "$value": "#fbf3db" },
        "strong": { "$type": "color", "$value": "#7a5a12" }
      },
      "danger": {
        "subtle": { "$type": "color", "$value": "#fff2f0" },
        "strong": { "$type": "color", "$value": "#963e38" }
      }
    },
    "overlay": {
      "12": { "$type": "color", "$value": "#0000001f" },
      "40": { "$type": "color", "$value": "#00000066" }
    },
    "document-selection": {
      "active": { "$type": "color", "$value": "#5b9bd54d" }
    },
    "document-search": {
      "match": { "$type": "color", "$value": "#f6d36566" },
      "current": { "$type": "color", "$value": "#f2b84b8f" }
    },
    "document-highlight": {
      "yellow": { "$type": "color", "$value": "#ffd400" },
      "red": { "$type": "color", "$value": "#ff6666" },
      "green": { "$type": "color", "$value": "#5fb236" },
      "blue": { "$type": "color", "$value": "#2ea8e5" },
      "purple": { "$type": "color", "$value": "#a28ae5" },
      "magenta": { "$type": "color", "$value": "#e56be5" },
      "orange": { "$type": "color", "$value": "#f19837" },
      "gray": { "$type": "color", "$value": "#9b9b95" }
    }
  },
  "palette": {
    "neutral": {
      "0": { "$type": "color", "$value": "{primitive.neutral.0}" },
      "25": { "$type": "color", "$value": "{primitive.neutral.25}" },
      "50": { "$type": "color", "$value": "{primitive.neutral.50}" },
      "100": { "$type": "color", "$value": "{primitive.neutral.100}" },
      "150": { "$type": "color", "$value": "{primitive.neutral.150}" },
      "200": { "$type": "color", "$value": "{primitive.neutral.200}" },
      "300": { "$type": "color", "$value": "{primitive.neutral.300}" },
      "400": { "$type": "color", "$value": "{primitive.neutral.400}" },
      "500": { "$type": "color", "$value": "{primitive.neutral.500}" },
      "550": { "$type": "color", "$value": "{primitive.neutral.550}" },
      "600": { "$type": "color", "$value": "{primitive.neutral.600}" },
      "700": { "$type": "color", "$value": "{primitive.neutral.700}" },
      "800": { "$type": "color", "$value": "{primitive.neutral.800}" },
      "900": { "$type": "color", "$value": "{primitive.neutral.900}" },
      "950": { "$type": "color", "$value": "{primitive.neutral.950}" },
      "1000": { "$type": "color", "$value": "{primitive.neutral.1000}" }
    },
    "accent": {
      "50": { "$type": "color", "$value": "{primitive.neutral.50}" },
      "100": { "$type": "color", "$value": "{primitive.neutral.100}" },
      "200": { "$type": "color", "$value": "{primitive.neutral.200}" },
      "300": { "$type": "color", "$value": "{primitive.neutral.300}" },
      "400": { "$type": "color", "$value": "{primitive.neutral.400}" },
      "500": { "$type": "color", "$value": "{primitive.neutral.500}" },
      "600": { "$type": "color", "$value": "{primitive.neutral.600}" },
      "700": { "$type": "color", "$value": "{primitive.neutral.700}" },
      "800": { "$type": "color", "$value": "{primitive.neutral.800}" },
      "900": { "$type": "color", "$value": "{primitive.neutral.900}" }
    },
    "status": {
      "info": {
        "subtle": {
          "$type": "color",
          "$value": "{primitive.status.info.subtle}"
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.status.info.strong}"
        }
      },
      "success": {
        "subtle": {
          "$type": "color",
          "$value": "{primitive.status.success.subtle}"
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.status.success.strong}"
        }
      },
      "warning": {
        "subtle": {
          "$type": "color",
          "$value": "{primitive.status.warning.subtle}"
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.status.warning.strong}"
        }
      },
      "danger": {
        "subtle": {
          "$type": "color",
          "$value": "{primitive.status.danger.subtle}"
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.status.danger.strong}"
        }
      }
    },
    "overlay": {
      "12": { "$type": "color", "$value": "{primitive.overlay.12}" },
      "40": { "$type": "color", "$value": "{primitive.overlay.40}" }
    },
    "document-selection": {
      "active": {
        "$type": "color",
        "$value": "{primitive.document-selection.active}"
      }
    },
    "document-search": {
      "match": {
        "$type": "color",
        "$value": "{primitive.document-search.match}"
      },
      "current": {
        "$type": "color",
        "$value": "{primitive.document-search.current}"
      }
    },
    "document-highlight": {
      "yellow": {
        "$type": "color",
        "$value": "{primitive.document-highlight.yellow}"
      },
      "red": {
        "$type": "color",
        "$value": "{primitive.document-highlight.red}"
      },
      "green": {
        "$type": "color",
        "$value": "{primitive.document-highlight.green}"
      },
      "blue": {
        "$type": "color",
        "$value": "{primitive.document-highlight.blue}"
      },
      "purple": {
        "$type": "color",
        "$value": "{primitive.document-highlight.purple}"
      },
      "magenta": {
        "$type": "color",
        "$value": "{primitive.document-highlight.magenta}"
      },
      "orange": {
        "$type": "color",
        "$value": "{primitive.document-highlight.orange}"
      },
      "gray": {
        "$type": "color",
        "$value": "{primitive.document-highlight.gray}"
      }
    }
  },
  "theme": {
    "font": {
      "interface": {
        "$type": "fontFamily",
        "$value": [
          "var(--font-geist-sans, Geist)",
          "PingFang SC",
          "Microsoft YaHei",
          "sans-serif"
        ]
      },
      "weight": {
        "normal": { "$type": "number", "$value": 400 },
        "medium": { "$type": "number", "$value": 500 },
        "semibold": { "$type": "number", "$value": 600 }
      }
    },
    "radius": {
      "xs": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "sm": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } },
      "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "xl": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "2xl": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } }
    },
    "icon": {
      "stroke": { "$type": "number", "$value": 1.5 }
    }
  },
  "elevation": {
    "overlay": {
      "$type": "shadow",
      "$value": {
        "color": "{color.elevation.shadow}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 12, "unit": "px" },
        "blur": { "value": 36, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "modal": {
      "$type": "shadow",
      "$value": {
        "color": "{color.elevation.shadow}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 20, "unit": "px" },
        "blur": { "value": 60, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "panel": {
      "$type": "shadow",
      "$value": {
        "color": "{color.elevation.shadow}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 0, "unit": "px" },
        "blur": { "value": 48, "unit": "px" },
        "spread": { "value": 0, "unit": "px" }
      }
    },
    "raised": {
      "$type": "shadow",
      "$value": {
        "color": "{color.elevation.shadow}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 4, "unit": "px" },
        "blur": { "value": 12, "unit": "px" },
        "spread": { "value": -4, "unit": "px" }
      }
    },
    "composer": {
      "$type": "shadow",
      "$value": {
        "color": "{color.elevation.composer}",
        "offsetX": { "value": 0, "unit": "px" },
        "offsetY": { "value": 6, "unit": "px" },
        "blur": { "value": 20, "unit": "px" },
        "spread": { "value": -10, "unit": "px" }
      }
    }
  }
}
